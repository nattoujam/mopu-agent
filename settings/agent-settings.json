{
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "TodoWrite",
      "Bash(cd:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git -C repo status:*)",
      "Bash(git -C repo diff:*)",
      "Bash(git -C repo log:*)",
      "Bash(git -C repo show:*)",
      "Bash(git -C repo add:*)",
      "Bash(git -C repo rm:*)",
      "Bash(git -C repo mv:*)",
      "Bash(git -C repo commit:*)",
      "Bash(git -C repo restore:*)",
      "Bash(git -C repo checkout:*)",
      "Bash(git -C repo stash:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)"
    ],
    "deny": [
      "Read(//home/nattou/.ssh/**)",
      "Read(//home/nattou/.claude/**)",
      "Read(//home/nattou/.config/**)",
      "Read(//home/nattou/.aws/**)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [],
      "strictAllowlist": true
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        }
      ]
    }
  }
}

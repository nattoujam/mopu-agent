#!/usr/bin/env bash
# Stop hook。MOPU_PHASE の state を終える条件（lib/outcome.sh）を満たすまで、2 回まで終えるのを拒む。
# 3 回目は終えるのを許し、run-task.sh が同じ検査でその state を失敗として記録する
set -uo pipefail

[[ -n ${MOPU_PHASE:-} && -n ${MOPU_TASK_DIR:-} && -n ${MOPU_LOG_DIR:-} ]] || exit 0
AGENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$AGENT_DIR/lib/common.sh"
source "$AGENT_DIR/lib/outcome.sh"
cat >/dev/null

problem=$(outcome_problem "$MOPU_PHASE" "$MOPU_TASK_DIR/$REPO_SUBDIR")
[[ -n $problem ]] || exit 0

count_file="$MOPU_LOG_DIR/phase-gate.count"
count=$(cat "$count_file" 2>/dev/null)
[[ $count =~ ^[0-9]+$ ]] || count=0
(( count < 2 )) || exit 0
printf '%s\n' "$(( count + 1 ))" > "$count_file"
printf 'まだ終えられない: %s。直してから終えること。\n' "$problem" >&2
exit 2

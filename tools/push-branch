#!/usr/bin/env bash
# エージェントが自分のブランチを push するための唯一の入口。sandbox の外
# （excludedCommands）で動くので、引数も cwd も信用せず、親が export した
# MOPU_TASK_DIR / MOPU_BRANCH だけを見る
set -euo pipefail

if (( $# )); then
  echo "push-branch は引数を取りません" >&2
  exit 2
fi
: "${MOPU_TASK_DIR:?}" "${MOPU_BRANCH:?}"

AGENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$AGENT_DIR/lib/common.sh"
source "$AGENT_DIR/lib/github-app.sh"
source "$AGENT_DIR/lib/workspace.sh"

repo=$(repo_of_task_dir "$MOPU_TASK_DIR") || die "想定外のタスクディレクトリです"
load_config "$repo" >/dev/null
[[ $MOPU_BRANCH == "$BRANCH_PREFIX"* ]] || die "想定外のブランチです: $MOPU_BRANCH"

wt=$(workspace_repo "$(realpath -m -- "$MOPU_TASK_DIR")")
if use_github_app; then
  GH_TOKEN=$(app_token) || die "GitHub App の認証に失敗しました"
  export GH_TOKEN
fi
push_workspace "$wt" "$MOPU_BRANCH"
echo "pushed: $MOPU_BRANCH"

# 対象リポジトリの CI はトリガーが pull_request だけのことが多く、PR が無いと
# 動かないため、最初の push で draft PR を作る。本文は run-task.sh が作業の終わりに書き換える
gh pr view "$MOPU_BRANCH" -R "$REPO" --json url >/dev/null 2>&1 && exit 0
[[ -n ${BASE_BRANCH:-} ]] || BASE_BRANCH=$(gh repo view "$REPO" --json defaultBranchRef --jq .defaultBranchRef.name 2>/dev/null || true)
if [[ -z $BASE_BRANCH ]]; then
  echo "既定ブランチを取得できなかったので、draft PR は作りませんでした。pull_request で動く CI は起動しません"
  exit 0
fi
number="${MOPU_BRANCH#"$BRANCH_PREFIX"}"
title=$(gh issue view "$number" -R "$REPO" --json title --jq .title 2>/dev/null) || title="#$number"
if url=$(gh pr create -R "$REPO" --draft --base "$BASE_BRANCH" --head "$MOPU_BRANCH" --title "$title" \
    --body "$(printf 'Closes #%s\n\nエージェントが作業中です。作業が終わると、この本文を結果で書き換えます。\n\n---\n%s' "$number" "$COMMENT_MARKER")" 2>&1); then
  echo "draft PR を作りました（CI が動きます）: $(grep -oE 'https://[^ ]+/pull/[0-9]+' <<<"$url" | tail -1)"
else
  echo "draft PR を作れませんでした。pull_request で動く CI は起動しません: $(tail -1 <<<"$url")"
fi

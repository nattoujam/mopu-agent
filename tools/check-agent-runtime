#!/usr/bin/env bash
# run-task.sh が頼っている Claude Code の挙動を実測する。Claude Code を更新したら実行する。claude -p を 2 回呼ぶ
#  - sandbox の中の Bash が dontAsk で自動で許可される（autoAllowBashIfSandboxed）
#  - Stop hook（mopu hook phase-gate）が終える条件を満たさない呼び出しを差し戻す
#  - PreToolUse hook（mopu hook phase-guard）が把握の state で出口ファイル以外への書き込みを拒む
set -euo pipefail

AGENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$AGENT_DIR/lib/common.sh"

claude_bin="${CLAUDE_BIN:-claude}"
dir=$(mktemp -d)
trap 'rm -rf -- "${dir:?}"' EXIT
wt="$dir/$REPO_SUBDIR"
mkdir -p "$wt" "$dir/log"
git -C "$wt" init -q
git -C "$wt" -c user.name=probe -c user.email=probe@localhost commit -q --allow-empty -m init

jq --arg wt "$wt" --arg mopu "$MOPU_BIN" \
  '.permissions.allow += ["Edit(/\($wt)/**)"]
   | .sandbox.filesystem = {allowWrite: [$wt]}
   | .hooks.PreToolUse = [{matcher: "Edit|Write|NotebookEdit|Bash", hooks: [{type: "command", command: "\($mopu) hook phase-guard"}]}]
   | .hooks.Stop = [{hooks: [{type: "command", command: "\($mopu) hook phase-gate"}]}]' \
  "$AGENT_DIR/settings/agent-settings.json" > "$dir/settings.json"

# 使い方: probe <state> <本文>
probe() {
  rm -f "$dir/log/phase-gate.count"
  (
    cd "$wt"
    env -u GH_TOKEN -u GITHUB_TOKEN MOPU_PHASE="$1" MOPU_TASK_DIR="$dir" MOPU_LOG_DIR="$dir/log" \
      MOPU_HEAD_START="$(git rev-parse HEAD)" \
      "$claude_bin" -p "$2" \
      --settings "$dir/settings.json" \
      --permission-mode dontAsk --setting-sources '' \
      --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
      --model haiku --max-budget-usd 0.2 </dev/null >/dev/null
  )
}

log "$("$claude_bin" --version)"
failed=0

probe implement "Bash ツールで次のコマンドを 1 回だけ実行してから終える。ほかのことはしない: echo probe > probe.txt"
if [[ -f $wt/probe.txt ]]; then
  log "✓ sandbox の中の Bash が自動で許可された"
else
  err "✗ sandbox の中の Bash が拒否された。settings/agent-settings.json の sandbox の設定を確かめる"
  failed=1
fi
if [[ -s $dir/log/phase-gate.count ]]; then
  log "✓ Stop hook が終えるのを差し戻した（$(<"$dir/log/phase-gate.count") 回）"
else
  err "✗ Stop hook が差し戻さなかった"
  failed=1
fi

probe triage-new "Write ツールで note.txt に probe と書いてから終える。拒否されたら、ほかの手段を試さずに終える"
if [[ ! -e $wt/note.txt ]]; then
  log "✓ PreToolUse hook が把握の state での書き込みを拒んだ"
else
  err "✗ PreToolUse hook が把握の state での書き込みを拒まなかった"
  failed=1
fi
exit "$failed"

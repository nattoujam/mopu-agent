# 設定の大半はコンソール（./console.sh）の「設定」で変更する。
# ここに置くのは、コンソールの起動前に要るものと、画面から変えさせないものだけ。

# --- Web コンソール ---
# 認証を持たないため、loopback 以外での待受は既定で拒否される。
# 公開する場合は CONSOLE_ALLOW_REMOTE=1 を設定し、前段で必ず認証をかけること。
CONSOLE_HOST="127.0.0.1"
CONSOLE_PORT=8787

# タスクを実行するコマンド。既定は claude。
# 動作検証では ./tools/fake-agent を指定すると LLM を呼ばずに分岐だけ踏める
# （挙動は FAKE_AGENT_MODE で切り替える。docs/development.md を参照）
#CLAUDE_BIN="./tools/fake-agent"

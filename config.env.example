# 対象リポジトリ（必須）
REPO="nattoujam/your-repo"
# PR のベースブランチ（省略時は gh でリポジトリの既定ブランチを取得する）
#BASE_BRANCH="main"

# タスクを受け付けるユーザー（空なら poll.sh は起動を拒否する）
# スペース区切りで複数指定可
ALLOWED_ACTORS="nattoujam"

# コメント内のトリガーコマンド（行頭にある場合のみ反応）
TRIGGER_COMMAND="/claude"

# ラベル状態機械
LABEL_QUEUED="agent:queued"
LABEL_RUNNING="agent:running"
LABEL_DONE="agent:done"
LABEL_FAILED="agent:failed"

# エージェント実行
MODEL="opus"
TASK_TIMEOUT="30m"
MAX_TASK_BUDGET_USD=3

# 利用枠ゲート
MAX_5H_PERCENT=50
MAX_7D_PERCENT=80

# 1回のポーリングで処理するタスクの最大数
MAX_TASKS_PER_RUN=3

# タスク分解時に作成する sub issue の上限
# 作成した sub issue には自動で agent:queued が付き、次回の poll から実装が走る
MAX_SUB_ISSUES=5

# 同時に進行させるタスク数（未マージの agent/issue-* PR の本数で判定）
# 0 で無制限。既定の 1 では、PR がマージ/クローズされるまで新しい Issue に着手しない
# 進行中 PR の元 Issue への /claude コメントは対象外（常に処理される）
MAX_OPEN_AGENT_PRS=1

# プロジェクト固有で追加したい権限（1要素につき1ルール）
# 例: EXTRA_ALLOWED_TOOLS=('Bash(npm test:*)' 'Bash(npm run:*)')
EXTRA_ALLOWED_TOOLS=()

# --- GitHub App として投稿する場合（任意） ---
# 未設定なら gh の既存認証（＝あなた自身のアカウント）で投稿する。
# 設定すると Issue コメント・PR が `<app-slug>[bot]` 名義になる。
# APP_ID は App 設定ページの "App ID"、APP_PRIVATE_KEY は生成した .pem のパス。
APP_ID=''
APP_PRIVATE_KEY=''
